    <string name="app_name">SweetSpot</string>

    <!-- Main screen -->
    <string name="cd_settings">Settings</string>
    <string name="cd_back">Back</string>
    <string name="main_description">SweetSpot helps you save money by finding the cheapest time to run your appliances. Just pick how long your appliance needs to run, and it will scan the next 24 hours of dynamic electricity prices to find the best window. You can also save your favourite appliances in settings for quick access.</string>
    <string name="main_find_button">Find Cheapest Window</string>
    <string name="main_searching">Searching…</string>
    <string name="main_add_appliances">Add your appliances</string>
    <string name="main_card_description">Find the cheapest time to run your appliance</string>

