    <!-- Quick guide -->
    <string name="guide_find_title">Find the cheapest time</string>
    <string name="guide_find_body">Pick how long your appliance needs to run, then tap Find.</string>
    <string name="guide_appliances_title">Save your appliances</string>
    <string name="guide_appliances_body">Add appliances in Settings for one-tap searches.</string>
    <string name="guide_ev_title">Plan EV charging</string>
    <string name="guide_ev_body">Add your car, enter its current and target charge, and SweetSpot works out the charging time.</string>
    <string name="guide_result_title">Read the result</string>
    <string name="guide_result_body">Use Earlier and Cheaper to shift the window, and press and hold the chart for any slot\'s price.</string>
    <string name="guide_allin_title">All-in price</string>
    <string name="guide_allin_body">Optionally show the full consumer price instead of just the market rate.</string>
    <string name="guide_wear_title">On your watch</string>
    <string name="guide_wear_body">Your appliances sync to Wear OS, so you can check prices without your phone.</string>

