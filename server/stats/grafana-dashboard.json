                    "group": "grafana-influxdb3-flightsql",
                    "kind": "DataQuery",
                    "spec": {
                      "format": "table",
                      "rawSql": "SELECT source, COUNT(*) AS total, SUM(CASE WHEN outcome = 'ok' THEN 1 ELSE 0 END) AS ok, SUM(CASE WHEN outcome = 'fail' THEN 1 ELSE 0 END) AS fail, ROUND(CAST(SUM(CASE WHEN outcome = 'ok' THEN 1 ELSE 0 END) AS DOUBLE) / COUNT(*) * 100, 1) AS success_pct FROM api_fetch WHERE source != 'test' AND time >= $__timeFrom AND time <= $__timeTo GROUP BY source ORDER BY total DESC"
