        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "sweetspot"
                    },
                    "group": "grafana-influxdb3-flightsql",
                    "kind": "DataQuery",
                    "spec": {
                      "format": "time_series",
                      "rawSql": "SELECT date_bin('1 hour', time) AS time, source, CAST(SUM(CASE WHEN outcome = 'ok' THEN 1 ELSE 0 END) AS DOUBLE) / COUNT(*) AS success_rate FROM api_fetch WHERE source != 'test' AND time >= $__timeFrom AND time <= $__timeTo GROUP BY 1, source ORDER BY 1"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
